
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Confia Mais -edit</title>
</head>

<body>

    <h2>Editar Registro</h2>

    <form action="/edit2/<%= crud._id %>" method="POST">

        <input type="text" value="<%= crud.nome %>" name="nome" required>

        <input type="text" value="<%= crud.cpf %>" name="cpf" required>

        <input type="text" value="<%= crud.telefone %>" name="telefone" required>

        <input type="date" value="<%= crud.data %>" name="data" required>

        <br/><br/>

        <a href="/show">Todos</a>

        <button type="submit">Editar</button>

    </form>

</body>

</html>
