
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Confia Mais</title>
</head>

<body>

    <h2>Usuários cadastrados</h2>

    <table border="1">

        <thead>
            <tr>
                <td>Nome</td>
                <td>Telefone</td>
                <td>Data de Nascimento</td>
                <td>Ação</td>
            </tr>
        </thead>

        <tbody>

            <% crud.forEach(function(details) { %>

                <tr>
                    <td><%= details.nome %></td>
                    <td><%= details.telefone %></td>
                    <td><%= details.data.split('-').reverse().join('/') %></td>

                    <td>
                        <a href="/edit2/<%= details._id %>">Editar</a> -
                        <a href="/delete/<%= details._id %>">Deletar</a>
                    </td>
                </tr>

            <% }) %>

        </tbody>

    </table>

    <button><a href="/index">Novo</a></button>

</body>
</html>
